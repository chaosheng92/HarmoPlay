<Window x:Class="HarmoPlay.Views.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="免责声明与风险提示" Height="560" Width="720"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⚠" FontSize="26" Foreground="#FFFF5A5A" Margin="0,0,10,0"/>
            <TextBlock x:Name="TxtHeader" Text="使用前请阅读：模拟按键与封号风险"
                       FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FF111722" BorderBrush="#33FF5A5A" BorderThickness="1"
                CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtBody" FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <CheckBox x:Name="ChkDontAsk" Grid.Row="2" Margin="0,12,0,0"
                  Content="我已了解上述风险，以后不再弹出这个提醒"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnDisagree" Content="不同意（改用跟谱弹奏）" Click="OnDisagree"/>
            <Button x:Name="BtnAgree" Content="同意并开启自动弹奏" Style="{StaticResource PrimaryButton}" Click="OnAgree"/>
        </StackPanel>
    </Grid>
</Window>
