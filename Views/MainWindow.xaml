<Window x:Class="HarmoPlay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="口琴谱演奏器 HarmoPlay"
        Height="800" Width="1260"
        MinHeight="620" MinWidth="1000"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 免责声明横幅 -->
        <Border x:Name="DisclaimerBar" Grid.Row="0" Background="#2EFF5A5A" BorderBrush="#66FF5A5A"
                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtDisclaimer" Foreground="#FFFFD9D9" FontSize="12" TextWrapping="Wrap"
                               Text="⚠ 免责声明：本软件的「自动弹奏」通过模拟键盘 / 鼠标按键实现，属于第三方辅助操作。多数游戏将其视为违规，存在账号被警告、限制或封禁的风险，是否使用由你自行决定并承担后果；「跟谱弹奏」不发送任何按键，仅作谱面提示，无此风险。"/>
                    <TextBlock x:Name="TxtDisclaimerMore" FontSize="11" Foreground="#FFB98A8A" Margin="0,3,0,0"
                               Visibility="Collapsed"
                               Text="（免责声明已收起，点右侧「展开」查看）"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnDisclaimerDetail" Content="完整声明" Margin="8,0,0,0" Click="OnShowDisclaimer"/>
                <Button Grid.Column="2" x:Name="BtnDisclaimerToggle" Content="收起" Margin="8,0,0,0" Click="OnToggleDisclaimer"/>
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="BtnPlay" Content="▶ 播放 / 暂停" Style="{StaticResource PrimaryButton}" Click="OnPlayPause" MinWidth="130"/>
                <Button x:Name="BtnStop" Content="■ 停止" Click="OnStop"/>
                <Button Content="⏮ 上一首" Click="OnPrevSong"/>
                <Button Content="⏭ 下一首" Click="OnNextSong"/>
                <Border Width="1" Background="{StaticResource Line}" Margin="6,2,14,2"/>
                <TextBlock Text="演奏方式" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ComboPlayMode" Width="196" Margin="0,0,10,0" SelectionChanged="OnPlayModeChanged"
                          ToolTip="自动弹奏：程序自己按键弹完整首；跟谱弹奏：程序不发按键，等你按对当前的音再走下一个（Alt+T 切换）"/>
                <CheckBox x:Name="ChkOverlay" Content="显示悬浮窗" Click="OnOverlayToggle"/>
                <TextBlock Text="悬浮窗样式" VerticalAlignment="Center" Margin="8,0,6,0"/>
                <ComboBox x:Name="ComboOverlayModeBar" Width="140" Margin="0,0,10,0"
                          SelectionChanged="OnOverlayModeBarChanged"
                          ToolTip="音游下落：音符按节奏从上方落到判定线；经典堆叠：音符块从下往上堆（Alt+M 也能切换）"/>
                <Border Width="1" Background="{StaticResource Line}" Margin="6,2,14,2"/>
                <Button Content="导入鼠鼠口琴谱曲库" Click="OnImportSquirrel"/>
                <Button Content="导入曲谱文件…" Click="OnImportFiles"/>
                <Button Content="新建曲谱" Click="OnNewSong"/>
                <Button Content="键位映射…" Click="OnOpenKeyMapEditor"/>
                <Border Width="1" Background="{StaticResource Line}" Margin="6,2,14,2"/>
                <Button Content="✋ 急停（松开全部按键）" Style="{StaticResource DangerButton}" Click="OnPanicRelease"
                        ToolTip="立刻停止演奏并强制松开所有按键与鼠标键（热键 Ctrl+Alt+0）"/>
            </WrapPanel>
        </Border>

        <!-- 主体 -->
        <TabControl Grid.Row="2" x:Name="Tabs">

            <!-- 曲谱库 -->
            <TabItem Header="曲谱库">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- 列表 -->
                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBox x:Name="TxtSearch" TextChanged="OnSearchChanged"
                                         ToolTip="按曲名 / 歌手 / 简谱内容搜索"/>
                                <TextBlock x:Name="TxtSearchHint" Text="搜索曲名 / 歌手 / 简谱…"
                                           Foreground="#7A8798" Margin="10,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <ComboBox x:Name="ComboFolders" Grid.Row="1" Margin="0,0,0,8"
                                      SelectionChanged="OnFolderChanged"/>

                            <ListBox x:Name="ListSongs" Grid.Row="2" SelectionChanged="OnSongSelected"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="绑定为快捷曲 1（Alt+4）" Tag="1" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 2（Alt+5）" Tag="2" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 3（Alt+6）" Tag="3" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 4（Alt+7）" Tag="4" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 5（Alt+8）" Tag="5" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 6（Alt+9）" Tag="6" Click="OnBindQuick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#8FA0B5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="删除" Style="{StaticResource DangerButton}" Click="OnDeleteSong"/>
                                <Button Content="重命名" Click="OnRenameSong"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 预览 -->
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtSongTitle" FontSize="16" FontWeight="SemiBold" Text="请选择一首曲谱"/>
                                <TextBlock x:Name="TxtSongMeta" Margin="12,4,0,0" Foreground="#8FA0B5" FontSize="12"/>
                            </StackPanel>
                            <ListBox x:Name="ListPreview" Grid.Row="1"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Mono, 微软雅黑"
                                                   FontSize="13" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 播放面板 -->
                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="当前音符" Style="{StaticResource SectionTitle}"/>
                                <Border Background="#FF111722" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtNowChord" Text="—" FontSize="28" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="#4A9DFF"/>
                                        <TextBlock x:Name="TxtNowDetail" Text="未播放" HorizontalAlignment="Center"
                                                   Foreground="#9AA4B5" FontSize="12" Margin="0,4,0,0"/>
                                        <ProgressBar x:Name="PrgSong" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                                     Foreground="#4A9DFF" Background="#22FFFFFF" BorderThickness="0"/>
                                        <TextBlock x:Name="TxtPlayMode" Text="自动弹奏" HorizontalAlignment="Center"
                                                   Foreground="#8FA0B5" FontSize="12" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="TxtFollowStats" Text="" HorizontalAlignment="Center"
                                                   Foreground="#4CD964" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="演奏参数" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BPM" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBpm" Grid.Column="1" TextChanged="OnParamChanged" ToolTip="留空=用曲谱自身速度"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="速度" VerticalAlignment="Center"/>
                                    <Slider x:Name="SldSpeed" Grid.Column="1" Minimum="0.2" Maximum="2.0" Value="1"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="OnSpeedChanged"/>
                                    <TextBlock x:Name="TxtSpeed" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="1.00x" Foreground="#8FA0B5" FontSize="12"/>
                                </Grid>
                                <WrapPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="Gap" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtGap" Width="52" TextChanged="OnParamChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="Lead" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtLead" Width="52" TextChanged="OnParamChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="倒计时" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtCountdown" Width="42" TextChanged="OnParamChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="重复" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtRepeat" Width="42" TextChanged="OnParamChanged"
                                                 ToolTip="1 = 一次；0 = 无限循环"/>
                                    </StackPanel>
                                </WrapPanel>
                                <CheckBox x:Name="ChkLegato" Content="同键连音不松手（推荐）" Click="OnParamChanged"/>
                                <TextBlock Text="提示：Gap/Lead 越小越紧凑；游戏掉音就把 Gap 调到 40~60。"
                                           Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                                <TextBlock Text="键位映射表" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
                                <Border Background="#FF111722" CornerRadius="6" Padding="8">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtMapName" Foreground="#8FA0B5" FontSize="12" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="ListMapRows">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="54"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Slot}" FontFamily="Consolas" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Key}" FontFamily="Consolas"
                                                                   FontSize="12" FontWeight="SemiBold" Foreground="#4A9DFF"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="#9AA4B5"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 编辑曲谱 -->
            <TabItem Header="编辑曲谱">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="曲名" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtEditName" Width="180" TextChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="歌手" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtEditArtist" Width="130" TextChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="BPM" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtEditBpm" Width="60" TextChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="拍号" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtEditMeter" Width="60" TextChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="分类" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ComboEditFolder" Width="140" SelectionChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text="记谱法" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ComboNotation" Width="170" SelectionChanged="OnNotationChanged"
                                          ToolTip="固定音高：1=C4，#/b 是半音、,/ ' 是八度，程序自动选指法（鼠鼠转谱规范）／直接按键：前缀就是鼠标键（三角洲可视化谱）"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="10">
                            <TextBox x:Name="TxtScore" AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Consolas, Cascadia Mono, 微软雅黑" FontSize="14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" TextChanged="OnScoreTextChanged"
                                     ToolTip="支持：1 2 3 4 5 6 7 8 / #6 / b3 / ^1 / 1' / 7, / 5 - / 0 / | / BPM=90"/>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="解析结果" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtParseInfo" FontSize="12" Foreground="#9AA4B5"/>
                                    <TextBlock x:Name="TxtParseWarn" FontSize="12" Foreground="#FFD23F" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="ListEditPreview" Grid.Row="2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <WrapPanel>
                            <Button Content="保存到曲谱库" Style="{StaticResource PrimaryButton}" Click="OnSaveSong"/>
                            <Button Content="另存为新曲谱" Click="OnSaveSongAs"/>
                            <Button Content="从文件导入…" Click="OnImportFiles"/>
                            <Button Content="导出为 TXT 简谱" Click="OnExportTxt"/>
                            <Button Content="导出为 JSON" Click="OnExportJson"/>
                            <Button Content="插入示例" Click="OnInsertExample"/>
                            <TextBlock x:Name="TxtEditHint" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="#8FA0B5" FontSize="12"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 键位与设置 -->
            <TabItem Header="键位与设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <GroupBox Header="键位映射">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="预设" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="ComboKeyMap" Width="300" SelectionChanged="OnKeyMapPresetChanged"/>
                                        <Button Content="编辑 / 自定义…" Click="OnOpenKeyMapEditor" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtKeyMapNote" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="全局热键（演奏控制）">
                                <StackPanel>
                                    <ItemsControl x:Name="ListHotkeys">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Desc}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="#8FA0B5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="改键" Margin="0"
                                                            Tag="{Binding}" Click="OnChangeHotkey"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TxtHotkeyWarn" Foreground="#FFD23F" FontSize="12" Margin="0,6,0,0"/>
                                    <TextBlock Text="说明：热键必须带 Ctrl 或 Alt，避免和游戏里的演奏按键冲突。"
                                               Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="数据">
                                <StackPanel>
                                    <TextBlock x:Name="TxtDataPath" FontSize="12" Foreground="#8FA0B5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="打开数据目录" Click="OnOpenDataDir"/>
                                        <Button Content="保存全部设置" Style="{StaticResource PrimaryButton}" Click="OnSaveAll"/>
                                        <Button Content="恢复默认设置" Click="OnResetSettings"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <GroupBox Header="悬浮窗">
                                <StackPanel>
                                    <CheckBox x:Name="ChkOverlayVisible" Content="启用悬浮窗" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkOverlayClickThrough" Content="点击穿透（不挡游戏操作，推荐）" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkOverlayLanes" Content="显示 8 条键位通道" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkOverlayKeys" Content="在音符块上显示按键字母" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkOverlayTitle" Content="显示曲名 / BPM / 进度" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkHideWhilePlaying" Content="演奏时自动隐藏悬浮窗" Click="OnOverlaySettingChanged"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="不透明度" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldOverlayOpacity" Grid.Column="1" Minimum="0.2" Maximum="1" Value="0.9"
                                                ValueChanged="OnOverlaySettingChanged"/>
                                        <TextBlock x:Name="TxtOverlayOpacity" Grid.Column="2" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#8FA0B5"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="每通道最多" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtOverlayStack" Grid.Column="1" TextChanged="OnOverlaySettingChanged"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="解锁拖动（Alt+L）" Click="OnUnlockOverlay"/>
                                        <Button Content="复位位置" Click="OnResetOverlayPosition"/>
                                        <Button Content="预览悬浮窗" Click="OnPreviewOverlay"/>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtOverlayHotkey" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="设置显示/隐藏快捷键…" Click="OnSetOverlayHotkey"/>
                                        <Button Content="设置备用快捷键…" Click="OnSetOverlayHotkey2"
                                                ToolTip="默认留空，位置随便你设；比如 Alt+\ 或 F8"/>
                                        <Button Content="清除备用" Click="OnClearOverlayHotkey2"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,4"
                                               Text="位置微调：解锁后可直接拖动悬浮窗（拖动条会变橙色），也可以在这里精确设置 / 点箭头微调"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtOverlayX" Width="56" TextChanged="OnOverlayPosChanged"/>
                                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                        <TextBox x:Name="TxtOverlayY" Width="56" TextChanged="OnOverlayPosChanged"/>
                                        <Button Content="←" Click="OnNudgeLeft" Margin="10,0,4,0"/>
                                        <Button Content="↑" Click="OnNudgeUp" Margin="0,0,4,0"/>
                                        <Button Content="↓" Click="OnNudgeDown" Margin="0,0,4,0"/>
                                        <Button Content="→" Click="OnNudgeRight" Margin="0"/>
                                        <Button Content="居中" Click="OnCenterOverlay" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="音游下落模式">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="ComboOverlayMode" Width="220" SelectionChanged="OnOverlaySettingChanged"/>
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="下落速度" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldFallSpeed" Grid.Column="1" Minimum="80" Maximum="600" Value="260"
                                                TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="OnOverlaySettingChanged"/>
                                        <TextBlock x:Name="TxtFallSpeed" Grid.Column="2" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#8FA0B5"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="提前显示" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtLookAhead" Grid.Column="1" TextChanged="OnOverlaySettingChanged"
                                                 ToolTip="音符在判定线上方多少秒开始出现"/>
                                    </Grid>
                                    <CheckBox x:Name="ChkJudgmentLine" Content="显示判定线与落点提示" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkFallKeyHint" Content="在音符块上显示按键字母" Click="OnOverlaySettingChanged"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="下落模式：音符按节奏从上方落下，落到最下面判定线时按键，像音游；跟练模式下会等你按对再继续。"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="演奏打断键（移动 / 跳跃 / 切枪 / 背包，可自定义）">
                                <StackPanel>
                                    <CheckBox x:Name="ChkInterruptEnabled" Content="启用打断检测" Click="OnInterruptSettingChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="打断后" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="ComboInterruptBehavior" Width="230" SelectionChanged="OnInterruptSettingChanged"/>
                                        <TextBlock Text="等" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                        <TextBox x:Name="TxtInterruptDelay" Width="56" TextChanged="OnInterruptSettingChanged"/>
                                        <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,4"
                                               Text="玩家按这些键时（游戏里的口琴会中断），程序自动暂停演奏，避免继续把按键灌进背包/菜单界面。"/>
                                    <ItemsControl x:Name="ListInterrupts">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                              Click="OnInterruptItemChanged" ToolTip="是否启用这个打断键"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding KeyText}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Memo}" FontSize="11" Foreground="#8FA0B5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="改键" Tag="{Binding}" Click="OnChangeInterrupt"/>
                                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource DangerButton}" Margin="0"
                                                            Tag="{Binding}" Click="OnRemoveInterrupt" ToolTip="删除这个打断键"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="＋ 添加打断键" Click="OnAddInterrupt"/>
                                        <Button Content="恢复默认（WASD/空格/1234/Tab）" Click="OnResetInterrupts"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtInterruptWarn" Foreground="#FFD23F" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="输入安全（防止按键/鼠标被卡住）">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSuppressMouse" Content="不发送鼠标修饰键（只按白键，绝不碰鼠标）"
                                              Click="OnInputSafetyChanged"
                                              ToolTip="勾上后不会按下左/中/右键，代价是升降调失效，只适合全白键的谱子"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="程序只在发键瞬间按住鼠标键，发完立刻松开；停止/急停/退出都会强制松开，另有 250ms 看门狗兜底。"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="✋ 立即松开所有按键" Style="{StaticResource DangerButton}" Click="OnPanicRelease"/>
                                        <Button Content="输入自检（查为什么没反应）" Click="OnInputSelfTest"
                                                ToolTip="装一个键盘钩子并注入一个测试按键，判断系统是否接受了本程序的模拟输入"/>
                                        <TextBlock x:Name="TxtInputGuard" VerticalAlignment="Center" FontSize="12" Foreground="#8FA0B5"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="跟谱弹奏（等你按键）">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="演奏方式选「跟谱弹奏」时生效：程序不发送任何按键，把悬浮窗/主界面当谱面，等你按对当前的音再走下一个。"/>
                                    <CheckBox x:Name="ChkFollowStrict" Content="严格判定：必须按对琴键（带变调的音还要按住对应鼠标键）"
                                              Click="OnFollowSettingChanged"/>
                                    <CheckBox x:Name="ChkFollowHold" Content="要求按住整拍（长音按不够记一次「漏」）"
                                              Click="OnFollowSettingChanged"/>
                                    <CheckBox x:Name="ChkFollowErrors" Content="按错时提示并统计"
                                              Click="OnFollowSettingChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="等不到就跳过" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtFollowTimeout" Grid.Column="1" Width="56" TextChanged="OnFollowSettingChanged"/>
                                        <TextBlock Grid.Column="2" Text="秒（0 = 一直等）" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#8FA0B5" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="更新与问题反馈">
                                <StackPanel>
                                    <TextBlock x:Name="TxtVersionInfo" FontSize="12" Foreground="#9AA4B5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="更新地址" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtUpdateUrl" Width="360" TextChanged="OnUpdateUrlChanged"
                                                 ToolTip="指向仓库里的 update.json（GitHub raw 地址），留空则不检查"/>
                                    </StackPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="检查更新" Style="{StaticResource PrimaryButton}" Click="OnCheckUpdate"/>
                                        <Button Content="打开下载页" Click="OnOpenDownloadPage"/>
                                        <Button Content="反馈问题（GitHub Issues）" Click="OnOpenIssues"/>
                                        <Button Content="导出诊断包" Click="OnExportDiagnostics"/>
                                        <Button Content="打开反馈目录" Click="OnOpenFeedbackDir"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtUpdateResult" FontSize="12" Foreground="#FFD23F" Margin="0,8,0,0"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="诊断包里只有程序版本、系统信息、键位/悬浮窗设置和最近日志，不含你的曲谱内容；反馈时把它拖进 Issue 即可。"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="关于">
                                <StackPanel>
                                    <TextBlock Text="口琴谱演奏器 HarmoPlay v1.0" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#9AA4B5"
                                               Text="本地离线版：曲谱库 + 简谱编辑 + 自动演奏 + 悬浮窗键位提示 + 可配置键位映射。"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#9AA4B5"
                                               Text="兼容「鼠鼠口琴谱」的 library.json 曲谱库，以及三角洲口琴可视化曲谱 / D-hydra 键位谱格式。"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#FFD23F"
                                               Text="在游戏内使用时，请以管理员身份运行本程序，否则部分游戏会忽略模拟按键。"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⬇ 示例曲谱" Padding="8,2" FontSize="11" Margin="0,0,6,0" Click="OnDownloadSampleScore"
                            ToolTip="另存为一份可直接导入的示例曲谱（小星星），并附带格式说明"/>
                    <Button Content="⬇ AI 转谱要求" Padding="8,2" FontSize="11" Margin="0" Click="OnDownloadAiSpec"
                            ToolTip="另存为一份可直接复制给 AI 的转谱要求 txt（含格式、音高、音域、自检清单）"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="就绪" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtVersion" HorizontalAlignment="Right" Foreground="#8FA0B5"
                           FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
