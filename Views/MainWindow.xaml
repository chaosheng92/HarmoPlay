<Window x:Class="HarmoPlay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:HarmoPlay.Views"
        Title="口琴谱演奏器 HarmoPlay"
        Height="800" Width="1260"
        MinHeight="620" MinWidth="1000"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 最顶端：模式切换（演奏 / 练习） -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="8,6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="TxtModeHint" VerticalAlignment="Center"
                           Foreground="#8FA0B5" FontSize="12" Margin="10,0,0,0"
                           Text="演奏模式：程序自动弹 / 跟谱提示　·　练习模式：不发送按键，实时判定你的每次按键"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnModePlay" Content="🎵 演奏模式" Padding="18,8" FontSize="14"
                            Click="OnModePlay" MinWidth="132"/>
                    <Button x:Name="BtnModePractice" Content="🎯 练习模式" Padding="18,8" FontSize="14" Margin="0"
                            Click="OnModePractice" MinWidth="132"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 免责声明横幅 -->
        <Border x:Name="DisclaimerBar" Grid.Row="1" Background="#2EFF5A5A" BorderBrush="#66FF5A5A"
                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtDisclaimer" Foreground="#FFFFD9D9" FontSize="12" TextWrapping="Wrap"
                               Text="⚠ 免责声明：本软件的「自动弹奏」通过模拟键盘 / 鼠标按键实现，属于第三方辅助操作。多数游戏将其视为违规，存在账号被警告、限制或封禁的风险，是否使用由你自行决定并承担后果；「跟谱弹奏」不发送任何按键，仅作谱面提示，无此风险。"/>
                    <TextBlock x:Name="TxtDisclaimerMore" FontSize="11" Foreground="#FFB98A8A" Margin="0,3,0,0"
                               Visibility="Collapsed"
                               Text="（免责声明已收起，点右侧「展开」查看）"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnDisclaimerDetail" Content="完整声明" Margin="8,0,0,0" Click="OnShowDisclaimer"/>
                <Button Grid.Column="2" x:Name="BtnDisclaimerToggle" Content="收起" Margin="8,0,0,0" Click="OnToggleDisclaimer"/>
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BtnSettings" Content="⚙ 设置" VerticalAlignment="Top"
                        Margin="10,0,0,0" Click="OnOpenSettings"
                        ToolTip="二级设置菜单：键位与变调 / 悬浮窗 / 演奏与跟谱 / 打断键 / 输入安全 / 全局热键 / 更新与反馈 / 数据与关于"/>
                <WrapPanel VerticalAlignment="Center">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Margin" Value="0,0,8,8"/>
                        </Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Margin" Value="0,0,10,8"/>
                        </Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="Margin" Value="0,4,16,8"/>
                        </Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Margin" Value="0,0,6,8"/>
                        </Style>
                    </WrapPanel.Resources>
                <Button x:Name="BtnPlay" Content="▶ 播放 / 暂停" Style="{StaticResource PrimaryButton}" Click="OnPlayPause" MinWidth="130"/>
                <Button x:Name="BtnStop" Content="■ 停止" Click="OnStop"/>
                <Button Content="⏮ 上一首" Click="OnPrevSong"/>
                <Button Content="⏭ 下一首" Click="OnNextSong"/>
                <Border Width="1" Background="{StaticResource Line}" Margin="6,2,14,2"/>
                <TextBlock Text="演奏方式" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ComboPlayMode" Width="196" Margin="0,0,10,0" SelectionChanged="OnPlayModeChanged"
                          ToolTip="自动弹奏：程序自己按键弹完整首；跟谱弹奏：程序不发按键，等你按对当前的音再走下一个（Alt+T 切换）"/>
                <CheckBox x:Name="ChkOverlay" Content="显示悬浮窗" Click="OnOverlayToggle"/>
                <TextBlock Text="悬浮窗样式" VerticalAlignment="Center" Margin="8,0,6,0"/>
                <ComboBox x:Name="ComboOverlayModeBar" Width="140" Margin="0,0,10,0"
                          SelectionChanged="OnOverlayModeBarChanged"
                          ToolTip="音游下落：音符按节奏从上方落到判定线；经典堆叠：音符块从下往上堆（Alt+M 也能切换）"/>
                <Border Width="1" Background="{StaticResource Line}" Margin="6,2,14,2"/>
                <Button Content="导入外部曲库" Click="OnImportSquirrel"/>
                <Button Content="导入曲谱文件…" Click="OnImportFiles"/>
                <Button Content="新建曲谱" Click="OnNewSong"/>
                <Border Width="1" Background="{StaticResource Line}" Margin="6,2,14,2"/>
                <Button Content="✋ 急停（松开全部按键）" Style="{StaticResource DangerButton}" Click="OnPanicRelease"
                        ToolTip="立刻停止演奏并强制松开所有按键与鼠标键（热键 Ctrl+Alt+0）"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 主体 -->
        <TabControl Grid.Row="3" x:Name="Tabs">

            <!-- 曲谱库 -->
            <TabItem Header="曲谱库">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- 列表 -->
                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBox x:Name="TxtSearch" TextChanged="OnSearchChanged"
                                         ToolTip="按曲名 / 歌手 / 简谱内容搜索"/>
                                <TextBlock x:Name="TxtSearchHint" Text="搜索曲名 / 歌手 / 简谱…"
                                           Foreground="#7A8798" Margin="10,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <ComboBox x:Name="ComboFolders" Grid.Row="1" Margin="0,0,0,8"
                                      SelectionChanged="OnFolderChanged"/>

                            <ListBox x:Name="ListSongs" Grid.Row="2" SelectionChanged="OnSongSelected"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="绑定为快捷曲 1（Alt+4）" Tag="1" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 2（Alt+5）" Tag="2" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 3（Alt+6）" Tag="3" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 4（Alt+7）" Tag="4" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 5（Alt+8）" Tag="5" Click="OnBindQuick"/>
                                        <MenuItem Header="绑定为快捷曲 6（Alt+9）" Tag="6" Click="OnBindQuick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#8FA0B5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="删除" Style="{StaticResource DangerButton}" Click="OnDeleteSong"/>
                                <Button Content="重命名" Click="OnRenameSong"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 预览 -->
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtSongTitle" FontSize="16" FontWeight="SemiBold" Text="请选择一首曲谱"/>
                                <TextBlock x:Name="TxtSongMeta" Margin="12,4,0,0" Foreground="#8FA0B5" FontSize="12"/>
                            </StackPanel>
                            <ListBox x:Name="ListPreview" Grid.Row="1"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Mono, 微软雅黑"
                                                   FontSize="13" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 播放面板 -->
                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="当前音符" Style="{StaticResource SectionTitle}"/>
                                <Border Background="#FF111722" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtNowChord" Text="—" FontSize="28" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="#4A9DFF"/>
                                        <TextBlock x:Name="TxtNowDetail" Text="未播放" HorizontalAlignment="Center"
                                                   Foreground="#9AA4B5" FontSize="12" Margin="0,4,0,0"/>
                                        <ProgressBar x:Name="PrgSong" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                                     Foreground="#4A9DFF" Background="#22FFFFFF" BorderThickness="0"/>
                                        <TextBlock x:Name="TxtPlayMode" Text="自动弹奏" HorizontalAlignment="Center"
                                                   Foreground="#8FA0B5" FontSize="12" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="TxtFollowStats" Text="" HorizontalAlignment="Center"
                                                   Foreground="#4CD964" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="演奏参数" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BPM" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBpm" Grid.Column="1" TextChanged="OnParamChanged" ToolTip="留空=用曲谱自身速度"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="速度" VerticalAlignment="Center"/>
                                    <Slider x:Name="SldSpeed" Grid.Column="1" Minimum="0.2" Maximum="2.0" Value="1"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="OnSpeedChanged"/>
                                    <TextBlock x:Name="TxtSpeed" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="1.00x" Foreground="#8FA0B5" FontSize="12"/>
                                </Grid>
                                <WrapPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="Gap" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtGap" Width="52" TextChanged="OnParamChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="Lead" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtLead" Width="52" TextChanged="OnParamChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="倒计时" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtCountdown" Width="42" TextChanged="OnParamChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="重复" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtRepeat" Width="42" TextChanged="OnParamChanged"
                                                 ToolTip="1 = 一次；0 = 无限循环"/>
                                    </StackPanel>
                                </WrapPanel>
                                <CheckBox x:Name="ChkLegato" Content="同键连音不松手（推荐）" Click="OnParamChanged"/>
                                <TextBlock Text="提示：Gap/Lead 越小越紧凑；游戏掉音就把 Gap 调到 40~60。"
                                           Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                                <TextBlock Text="键位映射表" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
                                <Border Background="#FF111722" CornerRadius="6" Padding="8">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtMapName" Foreground="#8FA0B5" FontSize="12" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="ListMapRows">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="54"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Slot}" FontFamily="Consolas" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Key}" FontFamily="Consolas"
                                                                   FontSize="12" FontWeight="SemiBold" Foreground="#4A9DFF"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="#9AA4B5"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 编辑曲谱 -->
            <TabItem Header="编辑曲谱">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="曲名" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtEditName" Width="180" TextChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="歌手" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtEditArtist" Width="130" TextChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="BPM" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtEditBpm" Width="60" TextChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="拍号" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtEditMeter" Width="60" TextChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="分类" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ComboEditFolder" Width="140" SelectionChanged="OnEditMetaChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text="记谱法" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ComboNotation" Width="170" SelectionChanged="OnNotationChanged"
                                          ToolTip="固定音高：1=C4，#/b 是半音、,/ ' 是八度，程序自动选指法／直接按键：前缀就是鼠标键（三角洲可视化谱）"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="10">
                            <TextBox x:Name="TxtScore" AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Consolas, Cascadia Mono, 微软雅黑" FontSize="14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" TextChanged="OnScoreTextChanged"
                                     ToolTip="支持：1 2 3 4 5 6 7 8 / #6 / b3 / ^1 / 1' / 7, / 5 - / 0 / | / BPM=90"/>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="解析结果" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtParseInfo" FontSize="12" Foreground="#9AA4B5"/>
                                    <TextBlock x:Name="TxtParseWarn" FontSize="12" Foreground="#FFD23F" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="ListEditPreview" Grid.Row="2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <WrapPanel>
                            <Button Content="保存到曲谱库" Style="{StaticResource PrimaryButton}" Click="OnSaveSong"/>
                            <Button Content="另存为新曲谱" Click="OnSaveSongAs"/>
                            <Button Content="从文件导入…" Click="OnImportFiles"/>
                            <Button Content="导出为 TXT 简谱" Click="OnExportTxt"/>
                            <Button Content="导出为 JSON" Click="OnExportJson"/>
                            <Button Content="插入示例" Click="OnInsertExample"/>
                            <TextBlock x:Name="TxtEditHint" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="#8FA0B5" FontSize="12"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 键位与设置 -->
            
        </TabControl>

        <!-- 练习模式面板（与曲谱库/编辑页签互斥显示） -->
        <Grid x:Name="PracticePanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="326"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,10,8,0">
                <StackPanel>
                    <TextBlock Text="练习曲谱" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ComboPracticeSong" SelectionChanged="OnPracticeSongChanged"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,2" Text="练习速度"/>
                    <Slider x:Name="SldPracticeSpeed" Minimum="0.4" Maximum="1.5" Value="0.8"
                            ValueChanged="OnPracticeSpeedChanged"/>
                    <TextBlock x:Name="TxtPracticeSpeed" Style="{StaticResource Caption}" Text="0.80x"/>
                    <CheckBox x:Name="ChkPracticeWait" Content="等你按对再前进（新手推荐）" IsChecked="True"
                              Checked="OnPracticeSettingChanged" Unchecked="OnPracticeSettingChanged"/>
                    <CheckBox x:Name="ChkPracticeMetronome" Content="显示节拍 / 判定线提示" IsChecked="True"
                              Checked="OnPracticeSettingChanged" Unchecked="OnPracticeSettingChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnPracticeStart" Content="▶ 开始练习" Style="{StaticResource PrimaryButton}" Click="OnPracticeStart"/>
                        <Button x:Name="BtnPracticeStop" Content="■ 停止" Click="OnPracticeStop"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0"
                               Text="练习模式不发送任何按键，程序只读取你的按键并实时判定。&#10;判定：完美 ±80ms ／ 良好 ±180ms ／ 再慢或按错 = 错过。&#10;右侧键盘可视化会实时亮起你按下的琴键与鼠标键。"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Margin="0,10,8,0">
                <v:OverlayCanvas x:Name="PracticeCanvas" Margin="6"/>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="实时反馈" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtPracticeVerdict" Text="准备开始" FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,6,0,12" Foreground="#8FA0B5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Caption}" Text="连击"/>
                            <TextBlock x:Name="TxtPracticeCombo" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FFFFD23F"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Caption}" Text="准确率"/>
                            <TextBlock x:Name="TxtPracticeAcc" Text="--" FontSize="28" FontWeight="Bold" Foreground="#FF4CD964"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TxtPracticeStats" Style="{StaticResource Caption}" Margin="0,12,0,4"
                               Text="完美 0　良好 0　错过 0"/>
                    <TextBlock x:Name="TxtPracticeNote" Style="{StaticResource Caption}" Margin="0,0,0,12"
                               Text="当前：未开始"/>
                    <TextBlock Text="你的按键（实时亮起）" Style="{StaticResource SectionTitle}" Margin="0,4,0,6"/>
                    <WrapPanel x:Name="PracticeKeys"/>
                </StackPanel>
            </Border>
        </Grid>


        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⬇ 示例曲谱" Padding="8,2" FontSize="11" Margin="0,0,6,0" Click="OnDownloadSampleScore"
                            ToolTip="另存为一份可直接导入的示例曲谱（小星星），并附带格式说明"/>
                    <Button Content="⬇ AI 转谱要求" Padding="8,2" FontSize="11" Margin="0" Click="OnDownloadAiSpec"
                            ToolTip="另存为一份可直接复制给 AI 的转谱要求 txt（含格式、音高、音域、自检清单）"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="就绪" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtVersion" HorizontalAlignment="Right" Foreground="#8FA0B5"
                           FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>









