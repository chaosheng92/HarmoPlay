<Window x:Class="HarmoPlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 口琴谱演奏器"
        Height="780" Width="1020" MinHeight="560" MinWidth="820"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"
                   Text="设置（左侧选分类；改完点右下角「保存并关闭」即可，多数设置立即生效）"/>

        <TabControl Grid.Row="1" x:Name="SettingsTabs" TabStripPlacement="Left">
            <TabItem Header="键位与变调">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,4,10">
                    <StackPanel>
<GroupBox Header="键位映射">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="预设" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="ComboKeyMap" Width="300" SelectionChanged="OnKeyMapPresetChanged"/>
                                        <Button Content="编辑 / 自定义…" Click="OnOpenKeyMapEditor" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtKeyMapNote" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="悬浮窗">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,4,10">
                    <StackPanel>
<GroupBox Header="悬浮窗">
                                <StackPanel>
                                    <CheckBox x:Name="ChkOverlayVisible" Content="启用悬浮窗" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkOverlayClickThrough" Content="点击穿透（不挡游戏操作，推荐）" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkOverlayLanes" Content="显示 8 条键位通道" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkOverlayKeys" Content="在音符块上显示按键字母" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkOverlayTitle" Content="显示曲名 / BPM / 进度" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkHideWhilePlaying" Content="演奏时自动隐藏悬浮窗" Click="OnOverlaySettingChanged"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="不透明度" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldOverlayOpacity" Grid.Column="1" Minimum="0.2" Maximum="1" Value="0.9"
                                                ValueChanged="OnOverlaySettingChanged"/>
                                        <TextBlock x:Name="TxtOverlayOpacity" Grid.Column="2" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#8FA0B5"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="每通道最多" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtOverlayStack" Grid.Column="1" TextChanged="OnOverlaySettingChanged"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="BtnLockOverlay" Content="解锁悬浮窗（可拖动 / 缩放）" Click="OnUnlockOverlay"/>
                                        <Button Content="复位位置" Click="OnResetOverlayPosition"/>
                                        <Button Content="预览悬浮窗" Click="OnPreviewOverlay"/>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtOverlayHotkey" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="设置显示/隐藏快捷键…" Click="OnSetOverlayHotkey"/>
                                        <Button Content="设置备用快捷键…" Click="OnSetOverlayHotkey2"
                                                ToolTip="默认留空，位置随便你设；比如 Alt+\ 或 F8"/>
                                        <Button Content="清除备用" Click="OnClearOverlayHotkey2"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,4"
                                               Text="位置微调：解锁后可直接拖动悬浮窗（拖动条会变橙色），也可以在这里精确设置 / 点箭头微调"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtOverlayX" Width="56" TextChanged="OnOverlayPosChanged"/>
                                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                        <TextBox x:Name="TxtOverlayY" Width="56" TextChanged="OnOverlayPosChanged"/>
                                        <Button Content="←" Click="OnNudgeLeft" Margin="10,0,4,0"/>
                                        <Button Content="↑" Click="OnNudgeUp" Margin="0,0,4,0"/>
                                        <Button Content="↓" Click="OnNudgeDown" Margin="0,0,4,0"/>
                                        <Button Content="→" Click="OnNudgeRight" Margin="0"/>
                                        <Button Content="居中" Click="OnCenterOverlay" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
<GroupBox Header="音游下落模式">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="ComboOverlayMode" Width="220" SelectionChanged="OnOverlaySettingChanged"/>
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="下落速度" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldFallSpeed" Grid.Column="1" Minimum="80" Maximum="600" Value="260"
                                                TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="OnOverlaySettingChanged"/>
                                        <TextBlock x:Name="TxtFallSpeed" Grid.Column="2" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#8FA0B5"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="提前显示" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtLookAhead" Grid.Column="1" TextChanged="OnOverlaySettingChanged"
                                                 ToolTip="音符在判定线上方多少秒开始出现"/>
                                    </Grid>
                                    <CheckBox x:Name="ChkJudgmentLine" Content="显示判定线与落点提示" Click="OnOverlaySettingChanged"/>
                                    <CheckBox x:Name="ChkFallKeyHint" Content="在音符块上显示按键字母" Click="OnOverlaySettingChanged"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="下落模式：音符按节奏从上方落下，落到最下面判定线时按键，像音游；跟练模式下会等你按对再继续。"/>
                                </StackPanel>
                            </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="演奏与跟谱">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,4,10">
                    <StackPanel>
<GroupBox Header="跟谱弹奏（等你按键）">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="演奏方式选「跟谱弹奏」时生效：程序不发送任何按键，把悬浮窗/主界面当谱面，等你按对当前的音再走下一个。"/>
                                    <CheckBox x:Name="ChkFollowStrict" Content="严格判定：必须按对琴键（带变调的音还要按住对应鼠标键）"
                                              Click="OnFollowSettingChanged"/>
                                    <CheckBox x:Name="ChkFollowHold" Content="要求按住整拍（长音按不够记一次「漏」）"
                                              Click="OnFollowSettingChanged"/>
                                    <CheckBox x:Name="ChkFollowErrors" Content="按错时提示并统计"
                                              Click="OnFollowSettingChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="等不到就跳过" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtFollowTimeout" Grid.Column="1" Width="56" TextChanged="OnFollowSettingChanged"/>
                                        <TextBlock Grid.Column="2" Text="秒（0 = 一直等）" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#8FA0B5" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="打断键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,4,10">
                    <StackPanel>
<GroupBox Header="演奏打断键（移动 / 跳跃 / 切枪 / 背包，可自定义）">
                                <StackPanel>
                                    <CheckBox x:Name="ChkInterruptEnabled" Content="启用打断检测" Click="OnInterruptSettingChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="打断后" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="ComboInterruptBehavior" Width="230" SelectionChanged="OnInterruptSettingChanged"/>
                                        <TextBlock Text="等" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                        <TextBox x:Name="TxtInterruptDelay" Width="56" TextChanged="OnInterruptSettingChanged"/>
                                        <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,4"
                                               Text="玩家按这些键时（游戏里的口琴会中断），程序自动暂停演奏，避免继续把按键灌进背包/菜单界面。"/>
                                    <ItemsControl x:Name="ListInterrupts">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                              Click="OnInterruptItemChanged" ToolTip="是否启用这个打断键"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding KeyText}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Memo}" FontSize="11" Foreground="#8FA0B5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="改键" Tag="{Binding}" Click="OnChangeInterrupt"/>
                                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource DangerButton}" Margin="0"
                                                            Tag="{Binding}" Click="OnRemoveInterrupt" ToolTip="删除这个打断键"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="＋ 添加打断键" Click="OnAddInterrupt"/>
                                        <Button Content="恢复默认（WASD/空格/1234/Tab）" Click="OnResetInterrupts"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtInterruptWarn" Foreground="#FFD23F" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="输入安全">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,4,10">
                    <StackPanel>
<GroupBox Header="输入安全（防止按键/鼠标被卡住）">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSuppressMouse" Content="不发送鼠标修饰键（只按白键，绝不碰鼠标）"
                                              Click="OnInputSafetyChanged"
                                              ToolTip="勾上后不会按下左/中/右键，代价是升降调失效，只适合全白键的谱子"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="程序只在发键瞬间按住鼠标键，发完立刻松开；停止/急停/退出都会强制松开，另有 250ms 看门狗兜底。"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="✋ 立即松开所有按键" Style="{StaticResource DangerButton}" Click="OnPanicRelease"/>
                                        <Button Content="输入自检（查为什么没反应）" Click="OnInputSelfTest"
                                                ToolTip="装一个键盘钩子并注入一个测试按键，判断系统是否接受了本程序的模拟输入"/>
                                        <TextBlock x:Name="TxtInputGuard" VerticalAlignment="Center" FontSize="12" Foreground="#8FA0B5"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="全局热键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,4,10">
                    <StackPanel>
<GroupBox Header="全局热键（演奏控制）">
                                <StackPanel>
                                    <ItemsControl x:Name="ListHotkeys">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Desc}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="#8FA0B5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="改键" Margin="0"
                                                            Tag="{Binding}" Click="OnChangeHotkey"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TxtHotkeyWarn" Foreground="#FFD23F" FontSize="12" Margin="0,6,0,0"/>
                                    <TextBlock Text="说明：热键必须带 Ctrl 或 Alt，避免和游戏里的演奏按键冲突。"
                                               Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="更新与反馈">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,4,10">
                    <StackPanel>
<GroupBox Header="更新与问题反馈">
                                <StackPanel>
                                    <TextBlock x:Name="TxtVersionInfo" FontSize="12" Foreground="#9AA4B5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="更新地址" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtUpdateUrl" Width="360" TextChanged="OnUpdateUrlChanged"
                                                 ToolTip="指向仓库里的 update.json（GitHub raw 地址），留空则不检查"/>
                                    </StackPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="检查更新" Style="{StaticResource PrimaryButton}" Click="OnCheckUpdate"/>
                                        <Button Content="打开下载页" Click="OnOpenDownloadPage"/>
                                        <Button Content="反馈问题（GitHub Issues）" Click="OnOpenIssues"/>
                                        <Button Content="导出诊断包" Click="OnExportDiagnostics"/>
                                        <Button Content="打开反馈目录" Click="OnOpenFeedbackDir"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtUpdateResult" FontSize="12" Foreground="#FFD23F" Margin="0,8,0,0"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="诊断包里只有程序版本、系统信息、键位/悬浮窗设置和最近日志，不含你的曲谱内容；反馈时把它拖进 Issue 即可。"/>
                                </StackPanel>
                            </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="数据与关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,4,10">
                    <StackPanel>
<GroupBox Header="数据">
                                <StackPanel>
                                    <TextBlock x:Name="TxtDataPath" FontSize="12" Foreground="#8FA0B5"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,4"
                                               Text="点右上角关闭窗口时"/>
                                    <ComboBox x:Name="ComboCloseAction" Width="260" HorizontalAlignment="Left"
                                              SelectionChanged="OnCloseActionChanged"
                                              ToolTip="退到后台后程序继续运行，托盘图标留在屏幕右下角（通知区域）"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="打开数据目录" Click="OnOpenDataDir"/>
                                        <Button Content="保存全部设置" Style="{StaticResource PrimaryButton}" Click="OnSaveAll"/>
                                        <Button Content="恢复默认设置" Click="OnResetSettings"/>
                                    </StackPanel>
                                    <Button Content="现在最小化到托盘试试" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Click="OnMinimizeToTray"/>
                                </StackPanel>
                            </GroupBox>
<GroupBox Header="关于">
                                <StackPanel>
                                    <TextBlock Text="口琴谱演奏器 HarmoPlay" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#9AA4B5"
                                               Text="本地离线版：曲谱库 + 简谱编辑 + 自动演奏 + 悬浮窗键位提示 + 可配置键位映射。"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#9AA4B5"
                                               Text="__DELETE_LINE__"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#FFD23F"
                                               Text="在游戏内使用时，请以管理员身份运行本程序，否则部分游戏会忽略模拟按键。"/>
                                </StackPanel>
                            </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtSettingsHint" VerticalAlignment="Center" Foreground="#8FA0B5" FontSize="12" Margin="0,0,14,0"/>
            <Button Content="恢复默认设置" Click="OnResetSettings"/>
            <Button Content="保存并关闭" Style="{StaticResource PrimaryButton}" Click="OnCloseSettings" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>




