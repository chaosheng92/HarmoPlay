<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HarmoPlay</AssemblyName>
    <RootNamespace>HarmoPlay</RootNamespace>
    <Version>1.0.0</Version>
    <Product>口琴谱演奏器</Product>
    <AssemblyTitle>口琴谱演奏器 HarmoPlay</AssemblyTitle>
    <Description>简谱曲谱库 / 自动演奏 / 悬浮窗键位提示（三角洲行动口琴预设）</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>none</DebugType>
    <!-- 自带 Main（Program.cs），禁用 WPF 自动生成的入口点 -->
    <StartupObject>HarmoPlay.Program</StartupObject>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
